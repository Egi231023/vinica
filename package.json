{
  "name": "north-and-vine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "North & Vine \u2014 a Canadian wine club experienced as a living book.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run map && npm run audit:content && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "map": "node --experimental-strip-types scripts/build-map.mjs",
    "audit:content": "node --experimental-strip-types scripts/audit-content.mjs",
    "smoke": "node scripts/smoke.mjs",
    "predev": "npm run map",
    "pretypecheck": "npm run map",
    "presmoke": "echo \"smoke expects a server: npm run build && npx next start -p 3300\""
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "next": "15.5.25",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "d3-geo": "3.1.1",
    "topojson-client": "3.1.0",
    "typescript": "5.7.2",
    "world-atlas": "2.0.2"
  }
}
